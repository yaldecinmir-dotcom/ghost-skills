  "policy": {
    "algorithm": "ed25519",
    "max_signatures_per_receipt": 1,
    "keyid_derivation": "\"ed25519:\" + sha256(raw_32_byte_public_key).hexdigest()[:32]",
    "scopes": {
      "receipt": "may sign receipts under the production profile",
      "fixture": "synthetic only; refused under the production profile",
      "facilitator": "may sign settlement evidence; may never sign a receipt"
    },
    "not_after": "null means open-ended. 0 means expired at the epoch. They are different and a verifier must not conflate them.",
    "rotation": "Publish the replacement with a future not_before while the predecessor keeps a not_after at or after that moment, so the windows overlap.",
    "retirement": "A retired key is never removed. signed_at is checked against the key window, not the clock, so historical receipts stay verifiable.",
    "revocation": "status=revoked with revoked_at. Receipts signed at or after that moment are refused; earlier ones are refused too unless revoked_at is set."
  },
